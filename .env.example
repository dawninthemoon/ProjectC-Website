# Copy to .env; generate each secret independently (openssl rand -hex 32).
POSTGRES_USER=projectc
POSTGRES_DB=projectc_analytics
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
# Separate from JWT_SIGNING_KEY; generate with openssl rand -hex 32.
BATTLE_API_KEY=
REFRESH_LIFETIME_DAYS=30
# Local .NET-free runtime uses Compose above. For npm/Neon use backend/.env.example.
