# URL-encode username/password. Neon: use the pooled URL and sslmode=require.
# Target: Neon project still-grass-68660241 / production branch / PostgreSQL 17.
# Copy actual pooled/direct URLs from Neon Connect; the project ID is not a host.
DATABASE_URL=postgresql://projectc:REPLACE_ME@localhost:5432/projectc_analytics?schema=public
# Neon: direct (non-pooler) URL for migration/inspection, with sslmode=require.
# Leave unset locally to use DATABASE_URL.
# DIRECT_URL=
JWT_SIGNING_KEY=
BATTLE_API_KEY=
JWT_ISSUER=ProjectC.Website
JWT_AUDIENCE=ProjectC.Client
JWT_LIFETIME_MINUTES=1440
REFRESH_LIFETIME_DAYS=30
GUEST_PERMIT_LIMIT=10
PORT=8080
CATALOG_PATH=catalog/cards.json
